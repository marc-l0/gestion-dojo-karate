{
  "name": "gestion-dojo-karate",
  "private": true,
  "description": "Sistema de gestión de dojo de karate: clases, profesores y postulaciones",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "commit": "cz",
    "prepare": "husky",
    "postinstall": "turbo run build --filter=@dojo/shared --output-logs=errors-only"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.11.4"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "type": "module"
}
