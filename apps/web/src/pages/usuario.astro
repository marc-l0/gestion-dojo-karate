---
import LayoutAdministracion from "../layouts/LayoutAdministracion.astro";
import Usuario from "../components/pantallas/Usuario.jsx";
import CerrarSesion from "../components/CerrarSesion.astro";
---
<LayoutAdministracion title="Usuario" active="usuario" backHref="/clases">
  <main class="space-y-4 px-4 pb-6 pt-4">
    <div><Usuario client:load /></div>
    <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" aria-label="Sesión">
      <p class="mb-4 text-sm text-gray-500">Al terminar en un equipo compartido, cierra tu sesión.</p>
      <CerrarSesion />
    </section>
  </main>
</LayoutAdministracion>
