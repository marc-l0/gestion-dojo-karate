---
import AdminLayout from "../layouts/AdminLayout.astro";
import Usuario from "../components/Usuario.jsx";
import Sesion from "../components/Sesion.astro";
---
<AdminLayout title="Usuario" active="usuario" backHref="/">
  <main class="space-y-4 px-4 pb-6 pt-4">
    <div><Usuario client:load /></div>
    <section class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm" aria-label="Sesión">
      <p class="mb-4 text-sm text-gray-500">Al terminar en un equipo compartido, cierra tu sesión.</p>
      <Sesion />
    </section>
  </main>
</AdminLayout>
