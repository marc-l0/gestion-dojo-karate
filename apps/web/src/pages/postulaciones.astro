---
import AdminLayout from "../layouts/AdminLayout.astro";
---
<AdminLayout title="Postulaciones" active="postulaciones" backHref="/">
    <div
      class="mx-auto min-h-0 w-full max-w-full bg-[#f7f9fb] text-gray-800"
    >

      <main class="space-y-4 px-4 pb-6 pt-4">
        <!-- RESUMEN -->
        <section
          class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm"
        >
          <div class="mb-3 flex items-center justify-between">
            <div>
              <p
                class="text-sm font-semibold uppercase tracking-wide text-gray-400"
              >
                Solicitudes de ingreso
              </p>

              <h2 class="mt-1 text-xs font-bold text-gray-800">
                Postulaciones recibidas
              </h2>
            </div>

            <span
              id="cantidadPostulaciones"
              class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-semibold text-purple-600"
            >
              0 solicitudes
            </span>
          </div>

          <p class="text-sm leading-4 text-gray-400">
            Revisa las solicitudes de los alumnos y asigna un cupo disponible en
            la clase correspondiente.
          </p>
        </section>

        <!-- SELECTOR DE CLASE -->
        <section
          class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm"
        >
          <p
            class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500"
          >
            CLASE
          </p>

          <select
            id="selectorClase"
            class="h-9 w-full rounded-xl border border-gray-200 bg-gray-50 px-3 text-sm text-gray-700 outline-none focus:border-blue-500"
          >
          </select>
        </section>

        <!-- RESUMEN DE CUPOS -->
        <div id="resumenCupos"></div>

        <!-- LISTA DE POSTULACIONES -->
        <section
          class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm"
        >
          <div class="mb-3 flex items-center justify-between">
            <div>
              <p
                class="text-xs font-medium uppercase tracking-wide text-gray-500"
              >
                SOLICITUDES
              </p>

              <h2 class="mt-1 text-sm font-bold text-gray-900">
                Alumnos interesados
              </h2>
            </div>

            <div class="flex items-center gap-1.5">
              <button
                id="cancelarSeleccion"
                type="button"
                class="hidden rounded-full border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-500"
              >
                Cancelar
              </button>

              <button
                id="eliminarPostulaciones"
                type="button"
                class="rounded-full border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-semibold text-red-500"
              >
                🗑 Eliminar
              </button>
            </div>
          </div>

          <div id="postulaciones" class="space-y-3"></div>
        </section>

        <!-- ACCESOS -->
        <section
          class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm"
        >
          <p
            class="mb-2 text-xs font-medium uppercase tracking-wide text-gray-500"
          >
            ACCESOS RÁPIDOS
          </p>

          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              onclick="window.location.href='/'"
              class="h-9 rounded-xl border border-gray-200 bg-white text-sm font-semibold text-gray-600 transition hover:bg-gray-50"
            >
              + Crear clase
            </button>

            <button
              type="button"
              onclick="window.location.href='/clases'"
              class="h-9 rounded-xl border border-gray-200 bg-white text-sm font-semibold text-gray-600 transition hover:bg-gray-50"
            >
              🥋 Gestionar clases
            </button>
          </div>
        </section>
      </main>

    </div>

    <script>
      import { apiFetch } from "../lib/api.js";

      async function cargarPostulaciones() {
        const contenedor = document.getElementById("postulaciones")!;

        const resumenCupos = document.getElementById("resumenCupos")!;

        const selectorClase = document.getElementById(
          "selectorClase",
        ) as HTMLSelectElement;

        const botonEliminar = document.getElementById("eliminarPostulaciones");

        const botonCancelar = document.getElementById("cancelarSeleccion");

        const cantidadPostulaciones = document.getElementById(
          "cantidadPostulaciones",
        );

        let postulaciones: any[] = [];
        let clases: any[] = [];
        let modoSeleccion = false;

        async function cargarDatos() {
          const respuestaPostulaciones = await apiFetch(
            "/clases/postulaciones",
          );

          if (!respuestaPostulaciones.ok) {
            throw new Error("No se pudieron obtener las postulaciones");
          }

          postulaciones = await respuestaPostulaciones.json();

          const respuestaClases = await apiFetch("/clases");

          if (!respuestaClases.ok) {
            throw new Error("No se pudieron obtener las clases");
          }

          clases = await respuestaClases.json();
        }

        const obtenerClase = (claseId: any) => {
          return clases.find((clase: any) => clase.id == claseId);
        };

        const obtenerEstadoVisual = (estado: any) => {
          if (estado === "aceptado" || estado === "aprobado") {
            return {
              texto: "Aprobado",
              clase: "bg-green-50 text-green-600",
            };
          }

          if (estado === "ignorado" || estado === "rechazado") {
            return {
              texto: "Ignorado",
              clase: "bg-red-50 text-red-500",
            };
          }

          return {
            texto: "Pendiente",
            clase: "bg-yellow-50 text-yellow-600",
          };
        };

        const obtenerCuposDisponibles = (claseId: any) => {
          const clase = obtenerClase(claseId);

          if (!clase) {
            return 0;
          }

          return Number(clase.cuposDisponibles ?? clase.cupos ?? 0);
        };

        const mostrarResumenCupos = (claseId: any) => {
          const clase = obtenerClase(claseId);

          if (!clase) {
            resumenCupos.innerHTML = "";
            return;
          }

          const cuposTotales = Number(clase.cupos ?? 0);

          const cuposDisponibles = obtenerCuposDisponibles(claseId);

          let textoEstado = "Cupos disponibles";

          let claseEstado = "bg-green-50 text-green-600";

          if (cuposDisponibles === 0) {
            textoEstado = "Sin cupos";
            claseEstado = "bg-red-50 text-red-500";
          } else if (cuposDisponibles <= 2) {
            textoEstado = "Últimos cupos";
            claseEstado = "bg-yellow-50 text-yellow-600";
          }

          resumenCupos.innerHTML = `
                        <div class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-medium uppercase tracking-wide text-gray-400">
                                        CUPOS DE LA CLASE
                                    </p>

                                    <p class="mt-1 text-sm font-semibold text-gray-800">
                                        ${cuposDisponibles} de ${cuposTotales} disponibles
                                    </p>
                                </div>

                                <span class="rounded-full px-2.5 py-1 text-xs font-semibold ${claseEstado}">
                                    ${textoEstado}
                                </span>
                            </div>
                        </div>
                        `;
        };

        const cargarSelectorClases = () => {
          selectorClase.innerHTML = "";

          clases.forEach((clase: any) => {
            const cantidad = postulaciones.filter(
              (postulacion) => postulacion.claseId == clase.id,
            ).length;

            const opcion = document.createElement("option");

            opcion.value = clase.id;

            opcion.textContent =
              clase.nivel +
              " · " +
              clase.sede +
              " · " +
              cantidad +
              " solicitudes";

            selectorClase.appendChild(opcion);
          });
        };

        const mostrarPostulaciones = (claseId: any) => {
          contenedor.innerHTML = "";

          const postulacionesFiltradas = postulaciones.filter(
            (postulacion) => postulacion.claseId == claseId,
          );

          if (cantidadPostulaciones) {
            cantidadPostulaciones.textContent = `${postulacionesFiltradas.length} ${
              postulacionesFiltradas.length === 1 ? "solicitud" : "solicitudes"
            }`;
          }

          if (postulacionesFiltradas.length === 0) {
            contenedor.innerHTML = `
                            <div class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-8 text-center">
                                <div class="text-2xl">
                                    📋
                                </div>

                                <p class="mt-2 text-sm font-semibold text-gray-600">
                                    No hay postulaciones
                                </p>

                                <p class="mt-1 text-xs text-gray-400">
                                    Esta clase todavía no tiene solicitudes.
                                </p>
                            </div>
                            `;

            return;
          }

          postulacionesFiltradas.forEach((postulacion) => {
            const tarjeta = document.createElement("div");

            const cuposDisponibles = obtenerCuposDisponibles(
              postulacion.claseId,
            );

            const fechaPostulacion = new Date(postulacion.fechaPostulacion);

            const hoyFecha = new Date();

            const inicioHoy = new Date(
              hoyFecha.getFullYear(),
              hoyFecha.getMonth(),
              hoyFecha.getDate(),
            );

            const inicioAyer = new Date(inicioHoy);

            inicioAyer.setDate(inicioAyer.getDate() - 1);

            let fechaTexto;

            if (fechaPostulacion >= inicioHoy) {
              fechaTexto = "Hoy";
            } else if (fechaPostulacion >= inicioAyer) {
              fechaTexto = "Ayer";
            } else {
              fechaTexto = fechaPostulacion.toLocaleDateString("es-PE", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
              });
            }

            const horaTexto = fechaPostulacion.toLocaleTimeString("es-PE", {
              hour: "numeric",
              minute: "2-digit",
            });

            const nacimiento = new Date(postulacion.fechaNacimiento);

            const hoy = new Date();

            let edad = hoy.getFullYear() - nacimiento.getFullYear();

            if (
              hoy.getMonth() < nacimiento.getMonth() ||
              (hoy.getMonth() === nacimiento.getMonth() &&
                hoy.getDate() < nacimiento.getDate())
            ) {
              edad--;
            }

            const tutor = postulacion.nombreCompletoApoderado || "";

            const estadoVisual = obtenerEstadoVisual(postulacion.estado);

            const estaIgnorado =
              postulacion.estado === "ignorado" ||
              postulacion.estado === "rechazado";

            tarjeta.className = "rounded-xl";

            tarjeta.innerHTML = `
                                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm ${
                                  estaIgnorado ? "opacity-60" : ""
                                }">

                                    <div class="p-3.5">

                                        <div class="mb-3 flex items-center justify-between">
                                            <span class="text-xs text-gray-400">
                                                ${fechaTexto} · ${horaTexto}
                                            </span>

                                            <span class="rounded-full px-2 py-1 text-xs font-semibold ${estadoVisual.clase}">
                                                ${estadoVisual.texto}
                                            </span>
                                        </div>

                                        <div class="flex items-center gap-2.5">

                                            ${
                                              modoSeleccion
                                                ? `
                                                    <input
                                                        type="checkbox"
                                                        class="checkbox-postulacion h-4 w-4 shrink-0 accent-blue-500"
                                                        data-id="${postulacion.id}"
                                                    />
                                                    `
                                                : ""
                                            }

                                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full ${
                                              estaIgnorado
                                                ? "bg-gray-200 text-gray-400"
                                                : "bg-blue-100 text-blue-600"
                                            } text-xs font-bold">
                                                ${postulacion.nombre
                                                  .charAt(0)
                                                  .toUpperCase()}
                                            </div>

                                            <div class="min-w-0 flex-1">
                                                <p class="truncate text-sm font-semibold text-gray-800">
                                                    ${postulacion.nombre}
                                                </p>

                                                <p class="text-xs text-gray-400">
                                                    ${edad} años${
                                                      edad < 18
                                                        ? " · Menor de edad"
                                                        : ""
                                                    }
                                                </p>
                                            </div>
                                        </div>

                                        ${
                                          edad < 18
                                            ? `
                                                <div class="mt-2.5 ml-[42px]">
                                                    <p class="text-sm text-gray-500">
                                                        Tutor:
                                                        <span class="font-semibold">
                                                            ${
                                                              tutor ||
                                                              "No registrado"
                                                            }
                                                        </span>
                                                    </p>
                                                </div>
                                                `
                                            : ""
                                        }

                                        <div class="mt-2.5 ml-[42px]">
                                            <p class="text-xs text-gray-400">
                                                📱 ${postulacion.telefono}
                                            </p>

                                            <p class="truncate text-xs text-gray-400">
                                                ✉ ${postulacion.correo}
                                            </p>
                                        </div>

                                        <div class="mt-3 rounded-xl bg-blue-50 px-3 py-2">
                                            <p class="text-sm font-semibold text-blue-700">
                                                🥋 ${postulacion.nivel}
                                                · ${postulacion.sede}
                                            </p>
                                        </div>
                                    </div>

                                    ${
                                      postulacion.estado === "pendiente"
                                        ? `
                                            <div class="grid grid-cols-2 border-t border-gray-200">

                                                <button
                                                    id="dar-cupo-${postulacion.id}"
                                                    class="cursor-pointer py-2.5 text-sm font-semibold text-green-600 transition hover:bg-green-50"
                                                >
                                                    ✓ Dar cupo
                                                </button>

                                                <button
                                                    id="ignorar-${postulacion.id}"
                                                    class="cursor-pointer border-l border-gray-200 py-2.5 text-sm font-medium text-gray-400 transition hover:bg-gray-50"
                                                >
                                                    Ignorar
                                                </button>

                                            </div>
                                            `
                                        : ""
                                    }

                                </div>
                                `;

            contenedor.appendChild(tarjeta);

            const checkbox = tarjeta.querySelector(
              ".checkbox-postulacion",
            ) as HTMLInputElement;

            checkbox?.addEventListener("change", () => {
              const seleccionados = document.querySelectorAll(
                ".checkbox-postulacion:checked",
              ).length;

              if (botonEliminar) {
                botonEliminar.textContent = `Eliminar seleccionados (${seleccionados})`;
              }
            });

            const botonCupo = document.getElementById(
              "dar-cupo-" + postulacion.id,
            );

            const botonIgnorar = document.getElementById(
              "ignorar-" + postulacion.id,
            );

            botonCupo?.addEventListener("click", async () => {
              if (cuposDisponibles <= 0) {
                alert("No quedan cupos disponibles para esta clase.");
                return;
              }

              botonCupo.setAttribute("disabled", "true");

              try {
                const respuesta = await apiFetch(
                  "/clases/postulaciones/estado",
                  {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                      id: postulacion.id,
                      estado: "aceptado",
                    }),
                  },
                );

                if (!respuesta.ok) {
                  throw new Error();
                }

                await cargarDatos();

                cargarSelectorClases();

                selectorClase.value = String(claseId);

                mostrarResumenCupos(selectorClase.value);

                mostrarPostulaciones(selectorClase.value);
              } catch {
                alert("No se pudo dar el cupo.");

                botonCupo.removeAttribute("disabled");
              }
            });

            botonIgnorar?.addEventListener("click", async () => {
              botonIgnorar.setAttribute("disabled", "true");

              try {
                const respuesta = await apiFetch(
                  "/clases/postulaciones/estado",
                  {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                      id: postulacion.id,
                      estado: "ignorado",
                    }),
                  },
                );

                if (!respuesta.ok) {
                  throw new Error();
                }

                await cargarDatos();

                cargarSelectorClases();

                selectorClase.value = String(claseId);

                mostrarResumenCupos(selectorClase.value);

                mostrarPostulaciones(selectorClase.value);
              } catch {
                alert("No se pudo ignorar la postulación.");

                botonIgnorar.removeAttribute("disabled");
              }
            });
          });
        };

        await cargarDatos();

        cargarSelectorClases();

        if (clases.length > 0) {
          selectorClase.value = String(clases[0].id);

          mostrarResumenCupos(selectorClase.value);

          mostrarPostulaciones(selectorClase.value);
        } else {
          contenedor.innerHTML = `
                        <div class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-8 text-center">
                            <p class="text-sm font-semibold text-gray-600">
                                No hay clases creadas
                            </p>

                            <p class="mt-1 text-xs text-gray-400">
                                Crea una clase para comenzar a recibir postulaciones.
                            </p>
                        </div>
                        `;
        }

        selectorClase.addEventListener("change", () => {
          mostrarResumenCupos(selectorClase.value);

          mostrarPostulaciones(selectorClase.value);
        });

        botonEliminar?.addEventListener("click", async () => {
          if (!modoSeleccion) {
            modoSeleccion = true;

            botonEliminar.textContent = "Eliminar seleccionados (0)";

            botonCancelar?.classList.remove("hidden");

            mostrarPostulaciones(selectorClase.value);

            return;
          }

          const checkboxesSeleccionados = document.querySelectorAll(
            ".checkbox-postulacion:checked",
          );

          const idsSeleccionados = Array.from(checkboxesSeleccionados).map(
            (checkbox) => Number(checkbox.getAttribute("data-id")),
          );

          if (idsSeleccionados.length === 0) {
            alert("Selecciona al menos una postulación.");
            return;
          }

          const confirmar = confirm(
            "¿Deseas eliminar las postulaciones seleccionadas?",
          );

          if (!confirmar) {
            return;
          }

          botonEliminar.setAttribute("disabled", "true");

          try {
            for (const id of idsSeleccionados) {
              const respuesta = await apiFetch("/clases/postulaciones/" + id, {
                method: "DELETE",
              });

              if (!respuesta.ok) {
                throw new Error();
              }
            }

            modoSeleccion = false;

            await cargarDatos();

            cargarSelectorClases();

            if (clases.length > 0) {
              selectorClase.value = String(
                clases.find((clase) => String(clase.id) === selectorClase.value)
                  ?.id ?? clases[0].id,
              );

              mostrarResumenCupos(selectorClase.value);

              mostrarPostulaciones(selectorClase.value);
            }
          } catch {
            alert("No se pudieron eliminar todas las postulaciones.");
          } finally {
            botonEliminar.removeAttribute("disabled");

            botonEliminar.textContent = "🗑 Eliminar";
          }
        });

        botonCancelar?.addEventListener("click", () => {
          modoSeleccion = false;

          if (botonEliminar) {
            botonEliminar.textContent = "🗑 Eliminar";
          }

          botonCancelar.classList.add("hidden");

          mostrarPostulaciones(selectorClase.value);
        });

        document
          .getElementById("volverInicio")
          ?.addEventListener("click", () => {
            window.location.href = "/";
          });
      }

      cargarPostulaciones().catch((error) => {
        console.error("Error al cargar postulaciones:", error);

        const contenedor = document.getElementById("postulaciones");

        if (contenedor) {
          contenedor.innerHTML = `
                        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-6 text-center">
                            <p class="text-sm font-semibold text-red-600">
                                No se pudieron cargar las postulaciones
                            </p>

                            <p class="mt-1 text-xs text-red-400">
                                Verifica que el backend esté ejecutándose.
                            </p>
                        </div>
                        `;
        }
      });
    </script>

</AdminLayout>
