NODE_ENV=development
PORT=3000

# Dirección de la web (sin "/" al final). Debe coincidir con la que abres en el navegador.
WEB_URL=http://localhost:4321
# En producción con subdominios (app.midojo.com y api.midojo.com): .midojo.com
COOKIE_DOMAIN=

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800

# Cuenta del administrador (la contraseña, de 12 caracteres o más)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-clave

# Hoja de Google: el id es el texto largo de la URL (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SPREADSHEET_ID=pega-aqui-el-id-de-tu-hoja
GOOGLE_CREDENTIALS_PATH=credentials/google-service-account.json
# Alternativa para hosting sin archivos: pega aquí el JSON completo de la llave
# GOOGLE_CREDENTIALS_JSON=
